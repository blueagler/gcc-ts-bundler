{
  "name": "gcc-ts-bundler",
  "version": "0.2.0",
  "description": "A TypeScript bundler that uses a native Rust front-end with Google Closure Compiler for aggressive optimization.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "bin": {
    "gcc-ts-bundler": "bin/gcc-ts-bundler.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "default": "./dist/vite/index.mjs"
    },
    "./presets/react": {
      "types": "./dist/presets/react.d.ts",
      "default": "./dist/presets/react.mjs"
    },
    "./presets/svelte": {
      "types": "./dist/presets/svelte.d.ts",
      "default": "./dist/presets/svelte.mjs"
    },
    "./presets/vue": {
      "types": "./dist/presets/vue.d.ts",
      "default": "./dist/presets/vue.mjs"
    }
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/bun": "^1.3.14",
    "@types/eslint": "9.6.1",
    "@types/google-closure-compiler": "^20231112.0.0",
    "@types/node": "^26.1.2",
    "esbuild": "^0.28.1",
    "eslint": "10.8.0",
    "eslint-plugin-perfectionist": "^5.10.0",
    "prettier": "^4.0.0-alpha.13",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0"
  },
  "peerDependencies": {
    "vite": "^7.0.0 || ^8.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "scripts": {
    "build:native": "node ./scripts/build-native.mjs",
    "build:native:cross": "node ./scripts/build-native.mjs --targets linux-x64-gnu,win32-x64-msvc",
    "build:native:all": "node ./scripts/build-native.mjs --all",
    "build:js": "node ./scripts/build-js.mjs",
    "build": "node ./scripts/build.mjs",
    "typecheck": "bun --bun tsc --noEmit && bun --bun tsc -p tsconfig.types.json --noEmit",
    "ledger": "bun --bun ./scripts/property-ledger.ts",
    "lint": "bun run typecheck && bun --bun ./scripts/format.ts --check && bun --bun eslint -c eslint.config.ts \"src/**/*.ts\"",
    "fix": "bun --bun ./scripts/format.ts && bun --bun eslint -c eslint.config.ts \"src/**/*.ts\" --fix",
    "test": "cargo test --manifest-path native/Cargo.toml && bun run build && bun test ./test/*.test.mjs",
    "preview:examples": "node ./scripts/preview-example.mjs",
    "verify:package": "node ./scripts/check-install-sanity.mjs && node ./scripts/verify-package.mjs",
    "prepublishOnly": "bun run verify:package",
    "publish:npm": "node ./scripts/publish-npm.mjs"
  },
  "keywords": [
    "typescript",
    "closure"
  ],
  "dependencies": {
    "google-closure-compiler": "20260726.0.0",
    "typescript": "^6.0.3"
  },
  "optionalDependencies": {
    "gcc-ts-bundler-darwin-arm64": "0.2.0",
    "gcc-ts-bundler-darwin-x64": "0.2.0",
    "gcc-ts-bundler-linux-arm64-gnu": "0.2.0",
    "gcc-ts-bundler-linux-arm64-musl": "0.2.0",
    "gcc-ts-bundler-linux-x64-gnu": "0.2.0",
    "gcc-ts-bundler-linux-x64-musl": "0.2.0",
    "gcc-ts-bundler-win32-arm64-msvc": "0.2.0",
    "gcc-ts-bundler-win32-x64-msvc": "0.2.0"
  },
  "files": [
    "bin",
    "dist",
    "docs",
    "closure-externs",
    "closure-lib",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  }
}
