{
  "name": "gcc-ts-bundler",
  "version": "0.1.7",
  "description": "A TypeScript bundler that uses Google Closure Compiler and Tsickle to bundle TypeScript code.",
  "type": "module",
  "main": "./bin/gcc-ts-bundler.cjs",
  "types": "./index.d.ts",
  "bin": {
    "gcc-ts-bundler": "./bin/gcc-ts-bundler.cjs"
  },
  "exports": {
    ".": "./bin/gcc-ts-bundler.cjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.1.0",
    "@types/bun": "^1.3.11",
    "@types/eslint": "9.6.1",
    "@types/google-closure-compiler": "^20231112.0.0",
    "@types/minimist": "^1.2.5",
    "@types/node": "^25.5.0",
    "@types/uglify-js": "^3.17.5",
    "eslint-plugin-perfectionist": "^5.7.0",
    "prettier": "^4.0.0-alpha.13",
    "typescript-eslint": "^8.57.3-alpha.3"
  },
  "scripts": {
    "build": "bun build ./src/entry/main.ts --outdir ./bin --format cjs --packages external --banner \"#!/usr/bin/env node\" --entry-naming \"gcc-ts-bundler.cjs\" --target node",
    "lint": "bun --bun tsc --noEmit && bun --bun ./scripts/format.ts && bun --bun eslint -c eslint.config.ts \"src/**/*.ts\" --fix",
    "publish": "bun publish"
  },
  "keywords": [
    "typescript",
    "closure"
  ],
  "dependencies": {
    "@swc/core": "^1.15.21",
    "@swc/types": "^0.1.26",
    "google-closure-compiler": "20260324.0.0",
    "minimist": "1.2.8",
    "typescript": "^6.0.2",
    "uglify-js": "3.19.3"
  },
  "files": [
    "bin",
    "index.d.ts",
    "README.md",
    "closure-externs",
    "closure-lib"
  ],
  "publishConfig": {
    "access": "public"
  }
}
