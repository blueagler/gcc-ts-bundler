{
  "name": "gcc-ts-bundler",
  "version": "0.1.8",
  "description": "A TypeScript bundler that uses a native Rust front-end with Google Closure Compiler for aggressive optimization.",
  "type": "module",
  "types": "./dist/index.d.ts",
  "bin": {
    "gcc-ts-bundler": "bin/gcc-ts-bundler.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "default": "./dist/vite/index.mjs"
    },
    "./native": {
      "types": "./dist/native/index.d.ts",
      "default": "./dist/native/index.mjs"
    }
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/bun": "^1.3.11",
    "@types/eslint": "9.6.1",
    "@types/google-closure-compiler": "^20231112.0.0",
    "@types/node": "^25.5.0",
    "esbuild": "^0.27.7",
    "eslint": "10.1.0",
    "eslint-plugin-perfectionist": "^5.7.0",
    "prettier": "^4.0.0-alpha.13",
    "typescript-eslint": "^8.57.3-alpha.3",
    "vite": "^7.3.2"
  },
  "peerDependencies": {
    "vite": "^7.0.0 || ^8.0.0"
  },
  "scripts": {
    "build:native": "node ./scripts/build-native.mjs",
    "build:native:cross": "node ./scripts/build-native.mjs --targets linux-x64-gnu,win32-x64-msvc",
    "build:native:all": "node ./scripts/build-native.mjs --all",
    "build:js": "node ./scripts/build-js.mjs",
    "build": "node ./scripts/build.mjs",
    "typecheck": "bun --bun tsc --noEmit && bun --bun tsc -p tsconfig.types.json --noEmit",
    "lint": "bun run typecheck && bun --bun ./scripts/format.ts && bun --bun eslint -c eslint.config.ts \"src/**/*.ts\" --fix",
    "test": "cargo test --manifest-path native/Cargo.toml && bun run build && bun test ./test/*.test.mjs",
    "publish:npm": "npm publish --access public --ignore-scripts"
  },
  "keywords": [
    "typescript",
    "closure"
  ],
  "dependencies": {
    "google-closure-compiler": "20260324.0.0",
    "typescript": "^6.0.2"
  },
  "optionalDependencies": {
    "gcc-ts-bundler-darwin-arm64": "0.1.8",
    "gcc-ts-bundler-darwin-x64": "0.1.8",
    "gcc-ts-bundler-linux-arm64-gnu": "0.1.8",
    "gcc-ts-bundler-linux-arm64-musl": "0.1.8",
    "gcc-ts-bundler-linux-x64-gnu": "0.1.8",
    "gcc-ts-bundler-linux-x64-musl": "0.1.8",
    "gcc-ts-bundler-win32-arm64-msvc": "0.1.8",
    "gcc-ts-bundler-win32-x64-msvc": "0.1.8"
  },
  "files": [
    "bin",
    "dist",
    "docs",
    "closure-externs",
    "closure-lib",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  }
}
