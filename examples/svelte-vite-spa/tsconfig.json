{
  "compilerOptions": {
    "allowJs": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ESNext"
  },
  "include": ["src/**/*.js", "src/**/*.svelte", "vite.config.ts"],
  "exclude": [".gcc-ts-bundler-vite/**", "dist/**"]
}
